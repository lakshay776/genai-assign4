# Environment Configuration
# Copy this file to .env and fill in your values

# --- Groq API (vision model for the AI / auto agent) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Default Task Config ---
TARGET_URL=https://ui.shadcn.com/docs/forms/react-hook-form
INSTRUCTION=Fill the form and submit it.
FILL_NAME=John Doe
FILL_DESCRIPTION=This is an automated form submission by my AI agent.

# --- Browser Settings ---
HEADLESS=false
SLOW_MO=50

# --- Agent Mode ---
# "auto" = generic instruction-driven agent (any URL + any task) — used by the web app
# "rule" = deterministic CSS selector form-fill
# "ai"   = vision-powered form-fill
AGENT_MODE=rule
MAX_STEPS=15

# --- Web App ---
PORT=5000
