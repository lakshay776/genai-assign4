# Environment Configuration
# Copy this file to .env and fill in your values

# --- Gemini API (for AI-augmented mode) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Target Task Config ---
TARGET_URL=https://ui.shadcn.com/docs/forms/react-hook-form
FILL_NAME=John Doe
FILL_DESCRIPTION=This is an automated form submission by my AI agent.

# --- Browser Settings ---
HEADLESS=false
SLOW_MO=50

# --- Agent Mode ---
# "rule" = deterministic CSS selector approach
# "ai"   = Gemini Vision powered dynamic agent
AGENT_MODE=rule
